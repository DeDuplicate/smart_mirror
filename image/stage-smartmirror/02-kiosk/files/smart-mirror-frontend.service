[Unit]
Description=Smart Mirror frontend (vite preview)
After=smart-mirror-backend.service
Wants=smart-mirror-backend.service

[Service]
Type=simple
User=FIRST_USER_NAME
WorkingDirectory=/opt/smart-mirror/frontend
ExecStart=/usr/bin/npx vite preview --port 3000 --host
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
