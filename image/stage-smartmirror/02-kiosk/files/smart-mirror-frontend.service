[Unit]
Description=Smart Mirror frontend (vite preview)
After=smart-mirror-backend.service
Wants=smart-mirror-backend.service

[Service]
Type=simple
User=FIRST_USER_NAME
WorkingDirectory=/opt/smart-mirror/frontend
# node/npx are resolved via PATH, not hardcoded: the official
# nodejs.org tarball installs to /usr/local/bin while the apt package
# uses /usr/bin, and pinning the wrong one makes the unit fail with
# "no such file or directory" - which looks like an X/kiosk fault.
ExecStart=/usr/bin/env npx vite preview --port 3000 --host
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
