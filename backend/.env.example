# ===========================================
# Smart Mirror Display — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# Spotify (for music playback control)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Home Assistant (for smart-home entity control)
HA_HOST=http://homeassistant.local:8123
HA_TOKEN=

# Token encryption secret (used to encrypt OAuth tokens at rest)
# If not set, a random key is auto-generated on first run and stored in the DB.
TOKEN_SECRET=

# Backend server
PORT=3001
NODE_ENV=production

# --- YouTube → MP3 casting (Nest Mini / Google Home) ---------------------
# Audio-only Google Cast targets can't render the YouTube app, so the backend
# streams a yt-dlp-extracted MP3 to them. These are optional:
#   YTDLP_PATH  — path to the yt-dlp binary   (default: "yt-dlp" on PATH)
#   FFMPEG_PATH — path to the ffmpeg binary   (default: "ffmpeg" on PATH)
#   STREAM_HOST — LAN IP/host the cast device uses to reach this server.
#                 Auto-detected when unset; set it if detection picks the
#                 wrong interface (e.g. Docker/VPN).
YTDLP_PATH=
FFMPEG_PATH=
STREAM_HOST=
