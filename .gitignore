node_modules/
.env
!.env.example
backend/db/*.db
backend/db/*.db-shm
backend/db/*.db-wal
logs/
dist/
# ...except the frontend bundle, which is SHIPPED rather than built on the Pi.
# The mirror is a 1GB Pi 2: running `vite build` on it spiked memory hard
# enough to exhaust CMA, kill Chromium's GPU process and drop the display into
# software rendering -- an update that visibly degraded the screen it was
# updating. Committing dist means a normal update is just a pull.
# Rebuild and commit it with any frontend change: `cd frontend && npx vite build`.
!frontend/dist/
backend/cache/
backend/backups/
# PM2 runtime logs (ecosystem.config.js writes these next to the backend)
backend/*.log
.DS_Store
home assistant connection details
.playwright-mcp/
.github/skills/
# pi-gen checkout created by image/build.sh
image/pi-gen/
*.png
!docs/screenshots/*.png
smart-mirror-*.png

# build.sh creds-free Docker config (Docker Desktop on WSL2 workaround)
image/.docker-nocreds/

# Reminder ringtones. User-supplied audio is often licensed (Epidemic Sound,
# Artlist, ...) and must stay on the device, out of git - so ignore the folder
# by default and un-ignore only the CC0 tones we ship. See CREDITS.md there.
backend/data/sounds/reminders/*
!backend/data/sounds/reminders/README.md
!backend/data/sounds/reminders/CREDITS.md
!backend/data/sounds/reminders/Alarm Clock.mp3
!backend/data/sounds/reminders/Buzzer.mp3
!backend/data/sounds/reminders/Chime.mp3
!backend/data/sounds/reminders/Pager.mp3

# Photo-frame images for the slideshow screensaver. Family photos stay on the
# device, out of git - see backend/data/photos/README.md.
backend/data/photos/*
!backend/data/photos/README.md
